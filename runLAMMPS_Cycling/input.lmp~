neighbor        ${h} bin

pair_style    sph/twospecies/isodiffusion/migration/csr/constRC/bv/nucleation
pair_coeff      * * ${h} ${d} ${sph_applied_pot_relax} ${sph_cC_init} ${sph_cA_init} ${sph_mass_thres} ${sph_N} ${sph_theta} ${sph_RC_Relax}


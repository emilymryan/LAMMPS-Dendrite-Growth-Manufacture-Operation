pair_coeff      * * ${h} ${d} ${sph_applied_pot_ch} ${sph_cC_init} ${sph_cA_init} ${sph_mass_thres} ${sph_N} ${sph_theta} ${sph_RC_Hi}

# # For LAMMPS neighbor lists
#neighbor      ${h} bin

dump          ${dump2} all custom ${nfreq} ${dname}/dump.*.dat id type x y d_dmM d_mM d_cA d_cC d_local_pot d_dcA d_dcC d_surf_energy d_nN d_dnN
timestep      ${dt}

# Print to screen
variable      time equal step*dt
thermo_style  custom step v_time
thermo        ${nfreq}

run     ${nrun_hi}

################# Dimensional parameters #######################

# Set the number of particles in the kernal
variable	neq equal 30 # Should be greater than 25 in 2D and >55 in 3D

# Kernel radius for mass transport in liquid phase
variable        h equal 1.0/${neq}

# Particle spacing
variable        dx equal ${h}/4.0

# Kernel radius for diffuse interface (mass transport between liquid and solid, reaction rate)
variable	d equal 2.0*${dx}

# Domain size
variable        L_x equal 5.0
variable        L_y equal 5.0

variable    	z equal ${dx}*0.5

variable 	x1  equal 0.55
variable 	y1  equal 0.64
variable 	r1  equal 0.5

variable        x2  equal 2.80
variable        y2  equal 2.04
variable 	r2  equal 0.7

variable        x3  equal 0.74
variable        y3  equal 2.73
variable 	r3  equal 0.6

variable        x4  equal 0.83
variable        y4  equal 4.03
variable 	r4  equal 0.7

variable        x5  equal 2.15
variable        y5  equal 1.11
variable 	r5  equal 0.4

variable        x6  equal 1.87
variable        y6  equal 2.86
variable 	r6  equal 0.4

variable        x7  equal 2.69
variable        y7  equal 4.17
variable 	r7  equal 0.35

variable        x8  equal 4.07
variable        y8  equal 4.38
variable 	r8  equal 0.35

variable        x9  equal 3.85
variable        y9  equal 2.82
variable 	r9  equal 0.5

variable        x10  equal 3.98
variable        y10  equal 0.79
variable 	r10  equal 0.7

variable        x11  equal 2.95
variable        y11  equal 1.00
variable        r11  equal 0.3

variable       	x12  equal 1.43
variable      	y12  equal 1.12
variable	r12  equal 0.25

variable       	x13  equal 0.50
variable      	y13  equal 1.69
variable	r13  equal 0.5

variable       	x14  equal 3.9
variable      	y14  equal 1.9
variable	r14  equal 0.4

variable       	x15  equal 1.57
variable      	y15  equal 1.9
variable	r15  equal 0.45

variable       	x16  equal 2.65
variable      	y16  equal 3.22
variable	r16  equal 0.5

variable        x17  equal 1.95 
variable        y17  equal 3.79
variable        r17  equal 0.3

variable        x18  equal 3.49
variable        y18  equal 3.79
variable        r18  equal 0.5

variable        x19  equal 4.68
variable        y19  equal 2.8
variable        r19  equal 0.25

variable        x20  equal 4.61
variable        y20  equal 1.91
variable        r20  equal 0.25

variable        x21  equal 1.92 
variable        y21  equal 4.51
variable        r21  equal 0.4

variable        x22  equal 4.45
variable        y22  equal 3.58
variable        r22  equal 0.4

variable        x23  equal 0.25 
variable        y23  equal 3.35
variable        r23  equal 0.2

variable        x24  equal 1.47
variable        y24  equal 0.43
variable        r24  equal 0.35

variable        x25  equal 2.21
variable        y25  equal 0.37
variable        r25  equal 0.3

variable        x26  equal 2.87 
variable        y26  equal 0.39
variable        r26  equal 0.3

variable        x27  equal 3.28
variable        y27  equal 4.57
variable        r27  equal 0.30

variable        x28  equal 4.77
variable        y28  equal 0.37
variable        r28  equal 0.20

################# SPH Particle properties #######################

variable 	sph_rho equal 1.0
variable        sph_mass equal ${sph_rho}*${dx}^2
variable	sph_mass_thres equal 2*${sph_mass}
variable	sph_mass_init1 equal ${sph_mass}

# Constant concentration locations
variable        anode_end equal 0.06
variable        const_conc equal ${L_y}-0.06

################# Diffusion properties #######################

# Diffusion for anions [um2/s]
variable        sph_DA equal 1.0

# Diffusion for cations  [um2/s]
variable        sph_DC equal 1.0

# Diffusion within inorganic component
variable        sph_DI equal 0.01

################# Reaction properties ########################

# Initial reaction rate [um/s]
variable        sph_RC1 equal 1.0e-4 #/${neq}
variable        sph_RC2 equal 1.0e-4 #/${neq}

################# Interfacial Energy Properties  #####################

# Interfacial Energy [J um-2]
variable        sph_surf_energy equal 1.716e-12 #J/um2

################# Contact Angle ##############################

# Contact Angle 
variable        sph_theta equal 90

################# Damkohler number ############################

# variable 	damk equal ${sph_RC}*(${const_conc_H}-${anode_end})/${sph_uni_DA}
# print		"Damkohler number: ${damk}"

################# Equilibrium and initial concentrations #######

variable        sph_const_cC equal 0.5
variable        sph_const_cA equal 0.5

variable	sph_cA_init equal 0.5
variable	sph_cC_init equal 0.5

# Charging equilibrium concentration
variable        sph_cCeq_ch equal 1.0/8.0 #${sph_mass}*2.0 
variable        sph_cAeq_ch equal 1.0/8.0 #${sph_mass}*2.0 #1.0/8.0

variable        sph_cCeq_disch equal 1.0 #${sph_mass}*2.0

############# Constant Calculations for Nucleation Rate ##########

#Total number of atoms per unit surface area
variable        da equal 0.001 #um
variable        Na equal 6.02e17 #Avagador's Number atoms/umol
variable        sph_N equal (1e-9)*${da}*${Na}*(${L_x}*${L_x})
 
################# Applied potential ###############################

# Potentials: 4V/0.5mm = 8e-3 V/um, linear from const_conc_H to anode_end 

# Charging potential
variable        charging_voltage equal 32e-3
variable        sph_applied_pot_ch equal ${charging_voltage}*(${const_conc}-${anode_end})
variable        sph_applied_pot_disch equal ${sph_applied_pot_ch}*-1

################# Critical Radius Calculation ########################

variable        sph_rad_init equal (2*${sph_surf_energy}*(13.02e12))/(96485*${sph_applied_pot_ch})
variable        rad equal ${sph_rad_init}

################# Mobility properties ##############################

# Anion mobility
variable        sph_muA equal 0.5

# Cation mobility
variable        sph_muC equal 0.5

# Concentration to charge [C/L]
# Faraday constant/(permitivity of water * Avagadros #)
variable	sph_conc_to_charge equal 1e-6


##########################################################################################
##########################################################################################
############################ Timestepping and run time ###################################
##########################################################################################
##########################################################################################

# Calculate the stable dt based on the parameters

include         settimestep.lmp

#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#!#
